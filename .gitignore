## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
[Bb]uilds/
[Oo]bj/
[Bb]in/
.deps/

# Visual Studio code coverage results
*.coverage
*.coveragexml

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.rsuser

# Rider
.idea/

# Visual Studio Code
.vscode/

# NuGet
*.nupkg
packages/
.nuget/

# .NET
project.lock.json
project.fragment.lock.json
artifacts/